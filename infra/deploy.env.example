# Coordinates of the AWS estate `make deploy` writes to.
#
# Copy to `infra/deploy.env` (gitignored) and fill in. These are identifiers,
# not credentials — every actual secret is fetched by ARN from Secrets Manager
# at deploy time and never appears in a task definition or in this file.
#
#   cp infra/deploy.env.example infra/deploy.env

AWS_ACCOUNT       = 000000000000
AWS_REGION        = ap-south-1
STACK             = fincon

COGNITO_POOL_ID   = ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID = xxxxxxxxxxxxxxxxxxxxxxxxxx

# The EFS filesystem holding runs and uploads, and the verified SES sender the
# pool sends confirmation codes as. `make ses` needs the sender; docs/14-AWS.md
# refers to the filesystem by `$EFS_ID` rather than printing it.
EFS_ID            = fs-xxxxxxxxxxxxxxxxx
SES_SENDER        = you@example.com

# The https:// name the service answers on. OAuth redirect URLs and the token
# audience are absolute, so this cannot be derived from a request.
DEPLOY_PUBLIC_URL = https://fincon.example.com

# ACM certificate for that name. Leaving this empty serves plain HTTP — which
# is fine for a first deploy and must not carry a session cookie in anger.
DEPLOY_CERT_ARN   = arn:aws:acm:ap-south-1:000000000000:certificate/xxxxxxxx
