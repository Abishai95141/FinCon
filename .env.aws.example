# FinCon — AWS configuration. Copy to `.env.aws`, source it, and run `make serve`.
# Provisioned 2026-08-26 in account ${AWS_ACCOUNT:?set AWS_ACCOUNT}, ap-south-1.
#
# Nothing here is authority. Policy, the taxonomy and the promoted rules come
# from signed bundles in the image; no variable below can widen what a close
# will accept. That separation is the point — see docs/04-CONTROL-PLANE-AUDIT.md.

export AWS_REGION=ap-south-1
export RECON_ENV=production
export RECON_AUTH=cognito

# Non-secret, published in SSM Parameter Store under /fincon/cognito/
export RECON_COGNITO_POOL_ID=$(aws ssm get-parameter --name /fincon/cognito/pool-id --query Parameter.Value --output text)
export RECON_COGNITO_CLIENT_ID=$(aws ssm get-parameter --name /fincon/cognito/client-id --query Parameter.Value --output text)

# Secrets. Never committed; fetched at boot by the task role.
export RECON_COGNITO_CLIENT_SECRET=$(aws secretsmanager get-secret-value --secret-id fincon/cognito-client-secret --query SecretString --output text)
export RECON_SESSION_SECRET=$(aws secretsmanager get-secret-value --secret-id fincon/session-secret --query SecretString --output text)

# Storage, created with Object Lock enabled (which can only be done at creation).
# The default retention is GOVERNANCE/1d so nothing is ever unprotected by
# accident; production switches the records bucket to COMPLIANCE, which nobody
# — including the account root — can undo for the retention period.
export RECON_RECORDS_BUCKET=fincon-records-${AWS_ACCOUNT:?set AWS_ACCOUNT}
export RECON_SOURCES_BUCKET=fincon-sources-${AWS_ACCOUNT:?set AWS_ACCOUNT}

# The public verification key for the authority bundles, supplied out of band.
export RECON_BUNDLE_PUBKEY=$(cat data/trust/authorized-key.hex)
