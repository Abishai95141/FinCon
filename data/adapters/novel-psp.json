{
  "spec_id": "novel-psp",
  "source": "novel-psp",
  "side": "settlement",
  "authored_by": "human",
  "currency": "INR",
  "reader": {
    "kind": "csv",
    "encoding": [
      "utf-8"
    ],
    "header_row": 3,
    "delimiter": ";"
  },
  "fields": [
    {
      "to": "date",
      "source": "booking_timestamp",
      "parse": "date",
      "fmt": "DD.MM.YYYY"
    },
    {
      "to": "amount",
      "source": "amount_minor",
      "parse": "decimal_minor"
    },
    {
      "to": "currency",
      "source": "ccy",
      "parse": "text"
    },
    {
      "to": "group_ref",
      "source": "merchant_batch",
      "parse": "text"
    },
    {
      "to": "reference",
      "source": "txn_ref",
      "parse": "text"
    },
    {
      "to": "key",
      "as_key": "payment_id",
      "source": "auth_code",
      "parse": "text"
    },
    {
      "to": "key",
      "as_key": "gateway",
      "source": "psp",
      "parse": "lower"
    },
    {
      "to": "key",
      "as_key": "row_type",
      "source": "kind",
      "parse": "lower"
    }
  ],
  "reject": [
    {
      "when": "row_blank",
      "reason": "blank"
    },
    {
      "when": "column_matches",
      "column": "transaction_reference",
      "pattern": "SUMMARY",
      "reason": "daily_summary_row"
    }
  ],
  "natural_key": [
    "keys.row_type",
    "keys.payment_id",
    "amount"
  ]
}
