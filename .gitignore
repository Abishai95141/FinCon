repos/
graphify-out/
__pycache__/
*.pyc
data/batches/*
!data/batches/MANIFEST.json
.venv/
# uv.lock is COMMITTED. It was ignored until 2026-08-28, which meant CI could
# never run: every job starts `uv sync --frozen`, the Dockerfile does
# `COPY pyproject.toml uv.lock ./`, and both need the file to exist in the
# repository. A lockfile that is not committed is not a lockfile — it pins
# nothing for anyone but the machine that generated it.
.pytest_cache/
.ruff_cache/

# coverage artifacts — binary, machine-local
.coverage
htmlcov/

# decision logs from local runs — the record is per-run, not a repo artifact
data/runs/
data/dev/
.scratch/

# per-account uploaded sources. A tenant directory is runtime state named by a
# user id — `12ff8a42…` is tracked because it is the shipped sample corpus the
# demo account reads; every other one appears when somebody signs up and must
# not follow them into the repo. Ignoring tracked files is a no-op, so the
# sample stays and the rest stop arriving.
data/sources/

# remotion project for the landing-page motion pieces
motion/node_modules/
motion/out/

# real deploy coordinates; the .example is the committed one
infra/deploy.env

# demo film renders — regenerate with `make demo-film`. The capture alone is
# 17MB and the cuts are 25MB each; the tooling is the artifact, not the output.
demo/
motion/out/
